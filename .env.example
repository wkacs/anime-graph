# --- Productionben kötelező ---

# Neon Postgres connection string. Titok; csak szerveroldalon használd.
DATABASE_URL=

# Elsődleges AI-szolgáltató (open.bigmodel.cn).
GLM_API_KEY=

# Legalább 32 karakteres, productionön egyedi session-aláírókulcs.
SESSION_SECRET=

# open | invite | closed. Ismeretlen érték biztonsági okból closed.
REGISTRATION_MODE=invite
# Csak invite módban kötelező.
INVITE_CODE=

# Napi összes AI-hívás minden felhasználóra együtt. Pozitív egész szám;
# productionben hiányzó/hibás érték fail-closed.
AI_GLOBAL_DAILY_LIMIT=500
# Opcionális szigorítás a beépített felhasználói/tier limitek fölött.
AI_DAILY_LIMIT=

# Resend rendszerlevelek. A FROM_EMAIL domainjét előbb ellenőrizd a Resendben.
RESEND_API_KEY=
FROM_EMAIL=Anime Graph <hello@mail.example.com>

# Legalább 32 karakteres, random titok a Vercel- és GitHub-cronokhoz.
CRON_SECRET=

# Stabil, publikus HTTPS origin, záró perjel nélkül.
APP_URL=https://example.com

# Jogi oldalak üzemeltetői adatai. A nyilvántartási szám opcionális.
NEXT_PUBLIC_OPERATOR_NAME=
NEXT_PUBLIC_OPERATOR_ADDRESS=
NEXT_PUBLIC_OPERATOR_REGISTRATION=
NEXT_PUBLIC_OPERATOR_EMAIL=

# --- Funkciótól függően szükséges ---

# Napi admin airing-digest címzettje. Ha üres, a digest cron szabályosan kihagy.
NOTIFY_EMAIL=

# Web push (generálás: npx web-push generate-vapid-keys).
NEXT_PUBLIC_VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:you@example.com

# Kétirányú lista-szinkron. Redirect URI:
# <APP_URL>/api/sync/<mal|anilist>/callback
MAL_CLIENT_ID=
MAL_CLIENT_SECRET=
ANILIST_CLIENT_ID=
ANILIST_CLIENT_SECRET=
# 32 random bájt base64 formában; a tárolt OAuth-tokenek AES-256-GCM kulcsa.
OAUTH_TOKEN_ENCRYPTION_KEY=

# --- Opcionális ---

# OpenRouter fallback, ha a GLM átmenetileg nem elérhető.
OPENROUTER_API_KEY=
OPENROUTER_MODEL=

# Könnyű klienshiba-továbbítás a saját /api/monitor route-on keresztül.
SENTRY_DSN=
