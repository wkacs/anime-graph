# Neon Postgres connection string (user provisions Neon manually)
DATABASE_URL=
# GLM API key (open.bigmodel.cn) — model: glm-4.7-flash
GLM_API_KEY=
# Random long string for signing the session cookies
SESSION_SECRET=
# Regisztráció-mód: open | invite | closed (default: open).
# invite módban az INVITE_CODE kötelező; ismeretlen érték = closed (biztonságos irány)
REGISTRATION_MODE=open
# Meghívó-kód — csak REGISTRATION_MODE=invite esetén használt
INVITE_CODE=
# Napi AI-hívás sapka fejenként (default: 20)
AI_DAILY_LIMIT=

# --- opcionális ---
# OpenRouter fallback, ha a GLM rate-limitel (model override: OPENROUTER_MODEL)
OPENROUTER_API_KEY=
# Resend: napi új-rész értesítés ÉS a regisztrációs/jelszó-visszaállító levelek.
# Kulcs nélkül a regisztráció működik, csak a levél marad el (console.warn).
RESEND_API_KEY=
NOTIFY_EMAIL=
# feladó a rendszer-levelekhez (default: no-reply@anime-graph.app)
FROM_EMAIL=
CRON_SECRET=
# Web push (generálás: npx web-push generate-vapid-keys)
NEXT_PUBLIC_VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:you@example.com
# Kétirányú lista-szinkron (D3) — OAuth-appok: myanimelist.net/apiconfig ill. anilist.co/settings/developer
# redirect URI mindkettőnél: <APP_URL>/api/sync/<mal|anilist>/callback
MAL_CLIENT_ID=
MAL_CLIENT_SECRET=
ANILIST_CLIENT_ID=
ANILIST_CLIENT_SECRET=
# a callback-URL-ekhez és a GH-cronokhoz (pl. https://anime-graph.vercel.app)
APP_URL=
